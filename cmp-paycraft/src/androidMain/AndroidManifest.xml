<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        androidx-startup wiring for PayCraftInitializer.

        The InitializationProvider node is contributed by the androidx.startup:
        startup-runtime library when it's on the consumer's classpath. We merge
        a single <meta-data> entry referencing our Initializer so the AndroidX
        Startup framework hands the Application Context to PayCraftPlatform
        before the consumer's Application.onCreate runs — no consumer-side
        PayCraftPlatform.init(applicationContext) call needed.

        See PayCraftInitializer.kt for the opt-out pattern.
    -->

    <!-- Lets InAppAuthBrowser find a Custom Tabs provider on Android 11+ (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application>
        <!--
            Sign-in Custom Tab host + return target (PLAN-paycraft-verified-identity D2b). identity-token's
            callback page fires intent://signin-complete#Intent;scheme=<applicationId>.paycraft;package=…
            Chrome only launches BROWSABLE activities from the web; singleTask clears the tab above it.
        -->
        <activity
            android:name="com.mobilebytelabs.paycraft.core.identity.PayCraftAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.paycraft" android:host="signin-complete" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.mobilebytelabs.paycraft.PayCraftInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
